[Unit]
Description=Vault secret management tool service
Documentation=https://developer.hashicorp.com/vault/docs
Requires=network-online.target
After=network-online.target

[Service]
User={{ vault_user }}
Group={{ vault_group }}

RuntimeDirectory={{ vault_user }}
RuntimeDirectoryMode=0750

ExecStart={{ vault_bin_path }}/vault server -config={{ vault_conf }}
ExecReload=/bin/kill -HUP $MAINPID

KillMode=process
KillSignal=SIGTERM

Restart=on-failure
RestartSec=42s

{% if not vault_mlock_disable %}
LimitMEMLOCK=infinity
{% endif %}

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths={{ vault_data_path }}

[Install]
WantedBy=multi-user.target
